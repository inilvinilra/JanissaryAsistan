DATABASE_URL=postgres://postgres:postgres@localhost:5432/jury_assistant
APP_ENV=development
# Development defaults to sample data. Production defaults to false and requires FILE_ENCRYPTION_KEY.
SEED_SAMPLE_DATA=true

# Leave empty to use the environment default: false in development, true in production.
VIRUS_SCAN_REQUIRED=
CLAMAV_COMMAND=clamscan

# Enable only behind a reverse proxy that overwrites client forwarding headers.
TRUST_PROXY_HEADERS=false

# Optional OCR executable for scanned PDFs and image submissions.
TESSERACT_COMMAND=tesseract
# Install required Tesseract language packages before setting additional languages.
OCR_LANGUAGES=eng

# Optional model-service scoring adapter. When unset, development uses the documented mock scorer.
AI_SCORING_URL=
AI_SCORING_TOKEN=

# Base64-encoded 32-byte AES-256-GCM key. It encrypts files at rest; provide it
# from a secret manager.
FILE_ENCRYPTION_KEY=

# Origins other than the dashboard are rejected. Configure the HTTPS origin in production.
PUBLIC_FRONTEND_ORIGIN=http://127.0.0.1:4321

# Optional webhook that accepts { to, subject, body, campaign_id } JSON for the
# bulk-email outbox. Keep credentials in the receiving service, not in this file.
EMAIL_WEBHOOK_URL=
